<Window x:Class="ProjectBrowserPlus.UI.Dialogs.CreateViewsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ProjectBrowserPlus.UI" Title="{ui:Tr dlg.createViews}" Width="440" Height="520" MinWidth="360" MinHeight="400">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectBrowserPlus;component/UI/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="Dialog"/></Window.Style>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Label Grid.Row="0" Style="{StaticResource FieldLabel}" Content="{ui:Tr cv.levels}"/>
    <ListBox x:Name="Levels" Grid.Row="1" SelectionMode="Extended" BorderBrush="{StaticResource Border}" DisplayMemberPath="Value"/>
    <StackPanel Grid.Row="2">
      <Label Style="{StaticResource FieldLabel}" Content="{ui:Tr cv.viewType}"/>
      <ComboBox x:Name="Types" Style="{StaticResource Combo}" DisplayMemberPath="Value"/>
      <Label Style="{StaticResource FieldLabel}" Content="{ui:Tr cv.template}"/>
      <ComboBox x:Name="Templates" Style="{StaticResource Combo}" DisplayMemberPath="Value"/>
      <Label Style="{StaticResource FieldLabel}" Content="{ui:Tr cv.name}"/>
      <TextBox x:Name="NameBox" Style="{StaticResource Input}" Text="{}{level}" ToolTip="{ui:Tr cv.nameTip}"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr btn.create}" Click="Ok_Click" Margin="0,0,6,0" IsDefault="True"/>
      <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.cancel}" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
