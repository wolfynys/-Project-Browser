<Window x:Class="ProjectBrowserPlus.UI.Dialogs.DuplicateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ProjectBrowserPlus.UI" Title="{ui:Tr dlg.duplicate}" Width="380" SizeToContent="Height" ResizeMode="NoResize">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectBrowserPlus;component/UI/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="Dialog"/></Window.Style>
  <StackPanel Margin="12">
    <TextBlock x:Name="Info" Style="{StaticResource Muted}"/>
    <Label Style="{StaticResource FieldLabel}" Content="{ui:Tr dup.mode}"/>
    <RadioButton x:Name="ModePlain" Content="{ui:Tr dup.plain}" IsChecked="True" Margin="0,2"/>
    <RadioButton x:Name="ModeDetail" Content="{ui:Tr dup.detailing}" Margin="0,2"/>
    <RadioButton x:Name="ModeDependent" Content="{ui:Tr dup.dependent}" Margin="0,2"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,8,0"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr dup.copies}"/><TextBox x:Name="CopiesBox" Style="{StaticResource Input}" Text="1"/></StackPanel>
      <StackPanel Grid.Column="1"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr dup.suffix}"/><TextBox x:Name="SuffixBox" Style="{StaticResource Input}" Text=" - {ui:Tr dup.copyWord}" ToolTip="{ui:Tr dup.suffixTip}"/></StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr btn.ok}" Click="Ok_Click" Margin="0,0,6,0" IsDefault="True"/>
      <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.cancel}" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
