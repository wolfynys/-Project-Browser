<Window x:Class="ProjectBrowserPlus.UI.Dialogs.PickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ProjectBrowserPlus.UI" Width="440" Height="520" MinWidth="320" MinHeight="300">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectBrowserPlus;component/UI/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="Dialog"/></Window.Style>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,6">
      <TextBox x:Name="Filter" Style="{StaticResource Input}" Padding="24,3,6,3" TextChanged="Filter_TextChanged"/>
      <ui:Icon Kind="search" Size="14" HorizontalAlignment="Left" Margin="7,0,0,0" Foreground="{StaticResource TextMuted}"/>
    </Grid>
    <ListBox x:Name="List" Grid.Row="1" BorderBrush="{StaticResource Border}" Background="{StaticResource Bg}" MouseDoubleClick="List_MouseDoubleClick">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" Padding="2"/></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="AllBtn" Style="{StaticResource TextButton}" Content="{ui:Tr btn.selectAll}" Click="All_Click" Margin="0,0,6,0"/>
      <CheckBox x:Name="Option" Style="{StaticResource Check}" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr btn.ok}" Click="Ok_Click" Margin="0,0,6,0" IsDefault="True"/>
      <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.cancel}" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
