<Window x:Class="ProjectBrowserPlus.UI.Dialogs.RenumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ProjectBrowserPlus.UI" Title="{ui:Tr dlg.renumber}" Width="600" Height="520" MinWidth="480" MinHeight="380">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectBrowserPlus;component/UI/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="Dialog"/></Window.Style>
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,6,0"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr rn.prefix}"/><TextBox x:Name="Prefix" Style="{StaticResource Input}" TextChanged="Changed"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,6,0"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr rn.start}"/><TextBox x:Name="Start" Style="{StaticResource Input}" Text="1" TextChanged="Changed"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,6,0"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr rn.step}"/><TextBox x:Name="Step" Style="{StaticResource Input}" Text="1" TextChanged="Changed"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="0,0,6,0"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr rn.digits}"/><TextBox x:Name="Digits" Style="{StaticResource Input}" Text="3" TextChanged="Changed"/></StackPanel>
      <StackPanel Grid.Column="4"><Label Style="{StaticResource FieldLabel}" Content="{ui:Tr rn.suffix}"/><TextBox x:Name="Suffix" Style="{StaticResource Input}" TextChanged="Changed"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
      <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.selectAll}" Click="All_Click" Margin="0,0,6,0"/>
      <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.selectNone}" Click="None_Click" Margin="0,0,6,0"/>
      <Button Style="{StaticResource IconButton}" ToolTip="{ui:Tr rn.moveUp}" Click="Up_Click"><ui:Icon Kind="chevron-down" Size="14" RenderTransformOrigin="0.5,0.5"><ui:Icon.RenderTransform><RotateTransform Angle="180"/></ui:Icon.RenderTransform></ui:Icon></Button>
      <Button Style="{StaticResource IconButton}" ToolTip="{ui:Tr rn.moveDown}" Click="Down_Click"><ui:Icon Kind="chevron-down" Size="14"/></Button>
      <CheckBox x:Name="KeepOrder" Style="{StaticResource Check}" Content="{ui:Tr rn.keepOrder}" IsChecked="True" Margin="12,0,0,0" ToolTip="{ui:Tr rn.keepOrderTip}" Click="KeepOrder_Click"/>
    </StackPanel>
    <DataGrid x:Name="Grid" Grid.Row="2" Style="{StaticResource Grid}" IsReadOnly="False" CanUserSortColumns="False">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Binding="{Binding On, UpdateSourceTrigger=PropertyChanged}" Width="30"/>
        <DataGridTextColumn Header="{ui:Tr rn.oldNumber}" Binding="{Binding Old}" IsReadOnly="True" Width="110"/>
        <DataGridTextColumn Header="{ui:Tr rn.newNumber}" Binding="{Binding New}" IsReadOnly="True" Width="110"/>
        <DataGridTextColumn Header="{ui:Tr rn.sheetName}" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0">
      <TextBlock x:Name="Summary" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.toDraft}" Click="Draft_Click" Margin="0,0,6,0" ToolTip="{ui:Tr draft.tip}"/>
        <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr btn.apply}" Click="Apply_Click" Margin="0,0,6,0"/>
        <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.cancel}" IsCancel="True"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
