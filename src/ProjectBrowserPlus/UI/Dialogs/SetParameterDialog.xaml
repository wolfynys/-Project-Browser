<Window x:Class="ProjectBrowserPlus.UI.Dialogs.SetParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ProjectBrowserPlus.UI" Title="{ui:Tr dlg.setParameter}" Width="400" SizeToContent="Height" ResizeMode="NoResize">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="pack://application:,,,/ProjectBrowserPlus;component/UI/Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <Window.Style><StaticResource ResourceKey="Dialog"/></Window.Style>
  <StackPanel Margin="12">
    <TextBlock x:Name="Info" Style="{StaticResource Muted}"/>
    <Label Style="{StaticResource FieldLabel}" Content="{ui:Tr sp.parameter}"/>
    <ComboBox x:Name="Params" Style="{StaticResource Combo}" IsEditable="True"/>
    <Label Style="{StaticResource FieldLabel}" Content="{ui:Tr sp.value}"/>
    <TextBox x:Name="ValueBox" Style="{StaticResource Input}"/>
    <TextBlock Text="{ui:Tr sp.hint}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource PrimaryButton}" Content="{ui:Tr btn.apply}" Click="Ok_Click" Margin="0,0,6,0" IsDefault="True"/>
      <Button Style="{StaticResource TextButton}" Content="{ui:Tr btn.cancel}" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
